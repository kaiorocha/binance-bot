# Copy this file to .env and fill in your Binance API credentials.
# Never commit your .env file.

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Trading pair (e.g. BTCUSDT, ETHUSDT)
SYMBOL=BTCUSDT

# Candle interval (1m, 5m, 15m, 1h, 4h, 1d)
INTERVAL=1h

# RSI parameters
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Order quantity (in base asset units)
TRADE_QUANTITY=0.001

# Set to "true" to use Binance Testnet
USE_TESTNET=false
