# Copy this file to .env and fill in your Binance API credentials.
# Never commit your .env file.

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Trading pair (e.g. BTCUSDT, ETHUSDT)
SYMBOL=BTCUSDT

# Candle interval (1m, 5m, 15m, 1h, 4h, 1d)
INTERVAL=1h

# RSI parameters
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Order quantity (in base asset units)
TRADE_QUANTITY=0.001

# Set to "true" to use Binance Testnet
USE_TESTNET=false

# ── Risk management ──────────────────────────────────────────────────────────

# Slow EMA period used as a trend filter (signals against the trend are ignored)
EMA_SLOW=21

# ATR (Average True Range) period for dynamic stop-loss / take-profit sizing
ATR_PERIOD=14

# Stop-loss distance = ATR_MULTIPLIER × ATR
# Take-profit distance = ATR_MULTIPLIER × ATR × 2  (2 : 1 reward/risk)
ATR_MULTIPLIER=2.0

# Fallback fixed-percentage stop-loss / take-profit when ATR is unavailable
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04

# Maximum realised loss in the quote asset (e.g. USDT) per UTC day.
# The bot pauses for 1 hour once this threshold is crossed (circuit-breaker).
MAX_DAILY_LOSS_USDT=50.0
